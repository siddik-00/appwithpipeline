<%- include('../header') -%>

<div class="auth-page">
  <div class="auth-card">
    <h1>Create account</h1>

    <% if (locals.error && error) { %>
      <p class="auth-msg error"><%= error %></p>
    <% } %>

    <form id="auth-form" method="post" action="/register">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" placeholder="e.g. tj" required />

      <label for="name">Full name</label>
      <input type="text" id="name" name="name" placeholder="e.g. TJ" required />

      <label for="email">Email</label>
      <input type="email" id="email" name="email" placeholder="e.g. tj@vision-media.ca" required />

      <label for="password">Password</label>
      <input type="password" id="password" name="password" placeholder="Choose a password" required />

      <button class="btn" type="submit">Register</button>
    </form>

    <p class="auth-switch">Already have an account? <a href="/login">Log in</a></p>
  </div>
</div>

<%- include('../footer') -%>