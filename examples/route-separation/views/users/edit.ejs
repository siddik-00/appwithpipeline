<%- include('../header') -%>

<h1>Editing <%= user.name %></h1>

<form id="user-form" action="?_method=put" method="post">
  <label for="name">Name</label>
  <input type="text" id="name" value="<%= user.name %>" name="user[name]" />

  <label for="email">Email</label>
  <input type="email" id="email" value="<%= user.email %>" name="user[email]" />

  <input type="submit" value="Save changes" />
</form>

<%- include('../footer') -%>
